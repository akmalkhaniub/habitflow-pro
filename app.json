{
  "expo": {
    "name": "HabitFlow Pro",
    "slug": "habitflow-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "habitflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0B1020"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      ["expo-notifications", { "color": "#6C8CFF" }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habitflow.pro"
    },
    "android": {
      "package": "com.habitflow.pro",
      "adaptiveIcon": {
        "backgroundColor": "#0B1020"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": ""
    }
  }
}
