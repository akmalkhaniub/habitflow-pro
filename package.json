{
  "name": "habitflow-pro",
  "version": "1.0.0",
  "description": "HabitFlow Pro — adaptive AI habit coach for iOS & Android, monetized with RevenueCat (Expo + React Native)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "tsx __tests__/habit_logic.test.ts && tsx __tests__/analytics.test.ts && tsx __tests__/notifications.test.ts && tsx __tests__/aicoach.test.ts",
    "coverage": "c8 sh -c \"tsx __tests__/habit_logic.test.ts && tsx __tests__/analytics.test.ts && tsx __tests__/notifications.test.ts && tsx __tests__/aicoach.test.ts\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-haptics": "~13.0.1",
    "expo-notifications": "^0.28.19",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-purchases": "^8.2.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "c8": "^10.1.3",
    "tsx": "^4.23.13",
    "typescript": "~5.3.3"
  },
  "private": true
}
